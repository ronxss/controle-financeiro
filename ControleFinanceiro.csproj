<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>ControleFinanceiro</RootNamespace>
    <UserSecretsId>controle-financeiro-local</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Google.Apis.Auth" Version="1.*" />
    <PackageReference Include="Microsoft.AspNetCore.Identity.EntityFrameworkCore" Version="10.0.*" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" Version="10.0.*" />
    <!-- Dependência indireta que vinha na 9.0.11 com 2 falhas de negação de serviço
         (GHSA-846f-f764-76mx, alta; GHSA-2fmv-rv2c-59x7, moderada). Corrigido na 10.0.13.
         Esta referência direta força a versão corrigida. Pode ser removida quando as
         dependências acima já trouxerem uma versão corrigida por conta própria. -->
    <PackageReference Include="System.Security.Cryptography.Pkcs" Version="10.0.13" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.*">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <!-- O front-end React fica em ClientApp e não faz parte da compilação C# -->
  <ItemGroup>
    <Compile Remove="ClientApp\**" />
    <Content Remove="ClientApp\**" />
    <EmbeddedResource Remove="ClientApp\**" />
    <None Remove="ClientApp\**" />
  </ItemGroup>

  <!-- Na primeira execução (wwwroot/index.html ausente) compila o React automaticamente -->
  <Target Name="CompilarClientApp" BeforeTargets="Build" Condition="'$(SkipClientBuild)' != 'true' And !Exists('$(MSBuildProjectDirectory)/wwwroot/index.html')">
    <Message Importance="high" Text="Instalando dependências e compilando o front-end React (primeira execução)..." />
    <Exec WorkingDirectory="$(MSBuildProjectDirectory)/ClientApp" Command="npm install" />
    <Exec WorkingDirectory="$(MSBuildProjectDirectory)/ClientApp" Command="npm run build" />
  </Target>

</Project>
